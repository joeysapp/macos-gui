#!/usr/bin/env python3
"""
airplay-tool - macOS AirPlay Screen Mirroring CLI

Features:
- Fast concurrent device discovery via Bonjour with stable indices and friendly name resolution.
- Target by index (1, 2), friendly name ("LG", "torus"), user alias ("tv"), MAC address, or UUID.
- 'toggle': Automatically disconnects if active, or reconnects to the last host with dynamic discovery wait.
- Clean disconnect with 'stop' / 'disconnect' (detects active macOS sessions).
- Native display mode control (mirror or extend) via display_ctl.
- Persistent state (last-connected host and mode) and shorthand alias management.
- Auto-reconnect watchdog ('watch') with configurable interval (default: 60000ms / 60s).
- State polling ('wait') blocking until connected, disconnected, or online (-t timeout).
- Unified Log diagnostic viewer ('logs') with --follow streaming, --limit, and --grep.
- Structured JSON output (-j, --json) across all commands for scripting and piping.
"""

import sys
import os
import re
import time
import json
import signal
import subprocess
from pathlib import Path
from concurrent.futures import ThreadPoolExecutor

VERSION = "0.4.0"
TOOL_NAME = "airplay-tool"

# Standard exit codes adhering to the macos-gui suite conventions
class ExitCode:
    OK = 0
    FAILED = 1
    USAGE = 2
    REFUSED = 3
    UNCONFIRMED = 4

# Standard paths adhering to XDG / macOS conventions
def get_state_dir():
    xdg = os.environ.get("XDG_STATE_HOME")
    return Path(xdg) / "macos-gui" if xdg else Path(os.path.expanduser("~/.local/state/macos-gui"))

def get_config_dir():
    xdg = os.environ.get("XDG_CONFIG_HOME")
    return Path(xdg) / "macos-gui" if xdg else Path(os.path.expanduser("~/.config/macos-gui"))

def get_cache_dir():
    xdg = os.environ.get("XDG_CACHE_HOME")
    return Path(xdg) / "macos-gui" if xdg else Path(os.path.expanduser("~/.cache/macos-gui"))

def get_state_file():
    return get_state_dir() / "airplay_state.json"

def get_alias_file():
    return get_config_dir() / "airplay_aliases.json"

def get_cache_file():
    return get_cache_dir() / "airplay_cache.json"

def iso_now():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())

# MARK: - Helpers & Output Handling

def die(msg, code=ExitCode.FAILED, as_json=False):
    if as_json:
        print(json.dumps({"error": str(msg), "code": code, "success": False}), flush=True)
    else:
        sys.stderr.write(f"error: {msg}\n")
    sys.exit(code)

def warn(msg, as_json=False):
    if not as_json:
        sys.stderr.write(f"warning: {msg}\n")

def parse_duration(val, default_sec=60.0):
    """
    Parses a duration string or number into seconds.
    Supports:
      - '60000ms', '500ms'
      - '60s', '3.5s', '60 sec', '60 seconds'
      - '1m', '2 min', '5 minutes'
      - '1h', '2 hours'
      - bare number: if >= 1000, treated as milliseconds (e.g. 60000 -> 60s);
                     if < 1000, treated as seconds (e.g. 60 -> 60s, 0.5 -> 0.5s)
    """
    if val is None:
        return default_sec
    s = str(val).strip().lower()
    if not s:
        return default_sec

    m = re.match(r"^([0-9]+(?:\.[0-9]+)?)\s*(ms|s|sec|secs|second|seconds|m|min|mins|minute|minutes|h|hr|hrs|hour|hours)?$", s)
    if not m:
        raise ValueError(f"invalid duration format '{val}'")

    num = float(m.group(1))
    unit = m.group(2)

    if unit == "ms":
        return num / 1000.0
    elif unit in ("s", "sec", "secs", "second", "seconds"):
        return num
    elif unit in ("m", "min", "mins", "minute", "minutes"):
        return num * 60.0
    elif unit in ("h", "hr", "hrs", "hour", "hours"):
        return num * 3600.0
    else:
        if num >= 1000.0:
            return num / 1000.0
        return num

def format_interval(sec):
    ms = int(round(sec * 1000))
    if sec >= 1.0 and sec.is_integer():
        return f"{ms}ms ({int(sec)}s)"
    elif sec >= 1.0:
        return f"{ms}ms ({sec:.1f}s)"
    return f"{ms}ms"

def run_cmd(args, timeout=None):
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout.strip(), p.stderr.strip()
    except subprocess.TimeoutExpired:
        return -1, "", "timeout"
    except Exception as e:
        return -1, "", str(e)

def run_applescript(script, *args):
    cmd = ["osascript", "-"] + list(args)
    p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    out, err = p.communicate(input=script)
    return p.returncode, out.strip(), err.strip()

# MARK: - State & Alias Management

def load_state():
    sf = get_state_file()
    legacy = get_cache_dir() / "airplay_state.json"
    for f in [sf, legacy]:
        if f.exists():
            try:
                with open(f, "r") as fp:
                    return json.load(fp)
            except Exception:
                pass
    return {}

def save_state(state):
    sf = get_state_file()
    try:
        sf.parent.mkdir(parents=True, exist_ok=True)
        with open(sf, "w") as fp:
            json.dump(state, fp, indent=2)
    except Exception:
        pass

def update_last_target(device, mode=None):
    state = load_state()
    target_info = {
        "name": device.get("name"),
        "target_id": device.get("target_id"),
        "deviceid": device.get("deviceid"),
        "psi": device.get("psi"),
        "model": device.get("model"),
        "updated_at": iso_now()
    }
    state["last_target"] = target_info
    if mode:
        state["last_mode"] = mode
    save_state(state)

def load_aliases():
    af = get_alias_file()
    if af.exists():
        try:
            with open(af, "r") as f:
                return json.load(f)
        except Exception:
            pass
    return {}

def save_aliases(aliases):
    af = get_alias_file()
    try:
        af.parent.mkdir(parents=True, exist_ok=True)
        with open(af, "w") as f:
            json.dump(aliases, f, indent=2)
    except Exception as e:
        sys.stderr.write(f"warning: failed to save aliases: {e}\n")

# MARK: - Device Discovery & Cache

def load_cache():
    cf = get_cache_file()
    legacy = get_state_dir() / "airplay_cache.json"
    for f in [cf, legacy]:
        if f.exists():
            try:
                with open(f, "r") as fp:
                    return json.load(fp)
            except Exception:
                pass
    return []

def save_cache(devices):
    cf = get_cache_file()
    try:
        cf.parent.mkdir(parents=True, exist_ok=True)
        with open(cf, "w") as fp:
            json.dump(devices, fp, indent=2)
    except Exception:
        pass

def _resolve_single_service(name, timeout=1.5, cached_map=None):
    lp = subprocess.Popen(["dns-sd", "-L", name, "_airplay._tcp", "local."],
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    out = ""
    deadline = time.time() + timeout
    while time.time() < deadline:
        line = lp.stdout.readline()
        if not line:
            break
        out += line
        if "deviceid=" in line:
            break
    lp.kill()
    try:
        rem, _ = lp.communicate(timeout=0.1)
        out += rem
    except Exception:
        pass

    dev_id = ""
    psi = ""
    model = ""
    m_dev = re.search(r"deviceid=([^\s]+)", out)
    if m_dev: dev_id = m_dev.group(1).upper()
    m_psi = re.search(r"psi=([^\s]+)", out)
    if m_psi: psi = m_psi.group(1).upper()
    m_mod = re.search(r"model=([^\s]+)", out)
    if m_mod: model = m_mod.group(1)

    # Fallback to cached device values if resolve timed out or was incomplete
    if (not dev_id or not psi) and cached_map and name in cached_map:
        cached = cached_map[name]
        if not dev_id: dev_id = cached.get("deviceid", "")
        if not psi: psi = cached.get("psi", "")
        if not model: model = cached.get("model", "")

    target_id = dev_id if dev_id else psi
    return {
        "name": name,
        "deviceid": dev_id,
        "psi": psi,
        "target_id": target_id,
        "model": model
    }

def discover_devices(timeout=1.0, verbose=False):
    p = subprocess.Popen(["dns-sd", "-B", "_airplay._tcp"],
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    try:
        out, _ = p.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        p.kill()
        out, _ = p.communicate()

    names = set()
    local_host = subprocess.run(["hostname", "-s"], capture_output=True, text=True).stdout.strip().lower()

    for line in out.splitlines():
        if "_airplay._tcp." in line and "STARTING" not in line:
            parts = line.split("_airplay._tcp.")
            if len(parts) > 1:
                name = parts[1].strip()
                if name and name.lower() not in [local_host, "localhost"]:
                    names.add(name)

    if not names:
        return []

    # Parallel resolution of TXT records for all discovered service names
    cached_map = {d["name"]: d for d in load_cache()}
    with ThreadPoolExecutor(max_workers=min(8, len(names))) as executor:
        devices = list(executor.map(lambda n: _resolve_single_service(n, timeout=1.0, cached_map=cached_map), sorted(names)))

    # Sort deterministically by friendly name
    devices.sort(key=lambda d: d["name"].lower())
    save_cache(devices)
    return devices

def normalize_identifier(target):
    if not target:
        return ""
    return re.sub(r"[^A-Fa-f0-9]", "", target).upper()

def resolve_target(target_str, devices=None, verbose=False):
    if not target_str:
        return None

    target_str = target_str.strip()

    if devices is None:
        devices = load_cache()
    if not devices:
        devices = discover_devices(timeout=1.0, verbose=verbose)

    # 0. Check user aliases first, but recursively resolve the expanded target
    aliases = load_aliases()
    if target_str.lower() in aliases:
        expanded = aliases[target_str.lower()].strip()
        if expanded.lower() != target_str.lower():
            res = resolve_target(expanded, devices=devices, verbose=verbose)
            if res:
                return res

    # 1. Direct hardware identifier match (MAC address or UUID)
    norm_target = normalize_identifier(target_str)
    if norm_target and len(norm_target) in (12, 32):
        for dev in devices:
            norm_dev = normalize_identifier(dev.get("deviceid", ""))
            norm_psi = normalize_identifier(dev.get("psi", ""))
            if (norm_dev and norm_target == norm_dev) or (norm_psi and norm_target == norm_psi):
                return dev

    # 2. 1-based index
    if target_str.isdigit():
        idx = int(target_str) - 1
        if 0 <= idx < len(devices):
            return devices[idx]

    # 3. Exact or substring match on friendly name
    lower_target = target_str.lower()
    for dev in devices:
        if lower_target == dev["name"].lower() or lower_target in dev["name"].lower():
            return dev

    # 5. Match on deviceid or psi substring
    if norm_target:
        for dev in devices:
            norm_dev = normalize_identifier(dev.get("deviceid", ""))
            norm_psi = normalize_identifier(dev.get("psi", ""))
            if (norm_dev and norm_target in norm_dev) or (norm_psi and norm_target in norm_psi):
                return dev

    # 6. If not found in cache, scan network once
    fresh_devices = discover_devices(timeout=1.2, verbose=verbose)
    if norm_target and len(norm_target) in (12, 32):
        for dev in fresh_devices:
            norm_dev = normalize_identifier(dev.get("deviceid", ""))
            norm_psi = normalize_identifier(dev.get("psi", ""))
            if (norm_dev and norm_target == norm_dev) or (norm_psi and norm_target == norm_psi):
                return dev

    for dev in fresh_devices:
        if lower_target in dev["name"].lower():
            return dev
        norm_dev = normalize_identifier(dev.get("deviceid", ""))
        norm_psi = normalize_identifier(dev.get("psi", ""))
        if norm_target and ((norm_dev and norm_target in norm_dev) or (norm_psi and norm_target in norm_psi)):
            return dev

    return None

# MARK: - Native Display Query & Mode Integration (display_ctl)

def find_display_ctl():
    script_dir = Path(__file__).resolve().parent
    candidates = [
        script_dir / "display-tool",
        script_dir / "display_ctl",
        script_dir.parent / "display_ctl" / "display-tool",
        script_dir.parent / "display_ctl" / "display_ctl",
        script_dir.parent.parent / "tools" / "display_ctl" / "display-tool",
        script_dir.parent.parent / "tools" / "display_ctl" / "display_ctl",
        Path(os.path.expanduser("~/.local/bin/display-tool")),
        Path(os.path.expanduser("~/.local/bin/display_ctl")),
        Path("/usr/local/bin/display-tool"),
        Path("/usr/local/bin/display_ctl"),
    ]
    for c in candidates:
        if c.exists() and os.access(c, os.X_OK):
            return str(c)
    return None

def get_online_displays_fast():
    """Returns list of online display names and properties via display_ctl in ~5ms."""
    ctl = find_display_ctl()
    if not ctl:
        return None
    code, out, _ = run_cmd([ctl, "list"])
    if code != 0:
        return None

    displays = []
    current = {}
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("Display ["):
            if current:
                displays.append(current)
            current = {"header": line}
        elif line.startswith("Name:") and current:
            current["name"] = line.split("Name:", 1)[1].strip()
        elif line.startswith("Type:") and current:
            current["type"] = line.split("Type:", 1)[1].strip()
        elif line.startswith("Mode:") and current:
            current["mode"] = line.split("Mode:", 1)[1].strip()
    if current:
        displays.append(current)
    return displays

def is_any_external_display_online():
    """Fast check: are any non-builtin displays connected?"""
    displays = get_online_displays_fast()
    if displays is None:
        return None
    if len(displays) <= 1:
        if displays and "Built-in" in displays[0].get("type", ""):
            return False
    for d in displays:
        if "External" in d.get("type", "") or "AirPlay" in d.get("name", ""):
            return True
    return False

def apply_display_mode(desired_mode, verbose=False):
    ctl = find_display_ctl()
    if not ctl:
        if verbose:
            sys.stderr.write("Note: display_ctl not found. Mode arrangement skipped.\n")
        return False

    for _ in range(10):
        time.sleep(0.5)
        code, out, _ = run_cmd([ctl, "list"])
        if "External / AirPlay" in out or "Secondary Display" in out or "(AirPlay)" in out:
            break

    code, out, err = run_cmd([ctl, desired_mode])
    if verbose:
        if code == 0:
            sys.stderr.write(f"display_ctl: {out}\n")
        else:
            sys.stderr.write(f"display_ctl warning: {err or out}\n")
    return code == 0

# MARK: - AppleScript UI Automation

def get_current_session_info(fast=True):
    if fast:
        online = is_any_external_display_online()
        if online is False:
            return None

    script = """
    tell application "System Events"
        tell process "ControlCenter"
            try
                set mbItem to first menu bar item of menu bar 1 whose description is "Screen Mirroring"
                click mbItem
                repeat with i from 1 to 20
                    if exists window 1 then exit repeat
                    delay 0.05
                end repeat
                
                set win to window 1
                set allEls to entire contents of win
                set activeDev to ""
                set activeMode to ""
                
                repeat with el in allEls
                    try
                        if role of el is "AXDisclosureTriangle" and (value of el as integer) is 1 then
                            set activeDev to value of attribute "AXIdentifier" of el
                        end if
                        if role of el is "AXCheckBox" and (value of el as integer) is 1 then
                            set activeDev to value of attribute "AXIdentifier" of el
                        end if
                        if role of el is "AXStaticText" then
                            set txtVal to value of el as string
                            if txtVal contains "Currently" then
                                set activeMode to txtVal
                            end if
                        end if
                    end try
                end repeat
                
                key code 53
                if activeDev is not "" then
                    return activeDev & " | " & activeMode
                else
                    return ""
                end if
            on error
                try
                    key code 53
                end try
                return ""
            end try
        end tell
    end tell
    """
    code, out, _ = run_applescript(script)
    if out:
        parts = out.split(" | ")
        dev_id = parts[0].replace("screen-mirroring-device-AirPlay:", "").strip()
        mode_str = parts[1].strip() if len(parts) > 1 else ""
        return {"device_id": dev_id, "mode": mode_str}
    return None

def toggle_mirroring_ui(action, target_id=""):
    script = """
    on run argv
        set theAction to item 1 of argv
        set theTarget to item 2 of argv
        
        tell application "System Events"
            tell process "ControlCenter"
                try
                    set mbItem to first menu bar item of menu bar 1 whose description is "Screen Mirroring"
                on error
                    return "Error: Screen Mirroring menu bar item not found in Control Center."
                end try
                
                click mbItem
                set win to missing value
                repeat with i from 1 to 30
                    if exists window 1 then
                        set win to window 1
                        exit repeat
                    end if
                    delay 0.05
                end repeat
                
                if win is missing value then
                    -- If menu didn't open immediately, give UI a moment and re-click
                    delay 0.2
                    click mbItem
                    repeat with i from 1 to 30
                        if exists window 1 then
                            set win to window 1
                            exit repeat
                        end if
                        delay 0.05
                    end repeat
                end if
                
                if win is missing value then
                    return "Error: Screen Mirroring menu window failed to open."
                end if
                set allEls to entire contents of win
                set targetElem to missing value
                
                if theAction is "stop" and theTarget is "" then
                    repeat with el in allEls
                        try
                            if role of el is "AXDisclosureTriangle" and (value of el as integer) is 1 then
                                set targetElem to el
                                exit repeat
                            end if
                            if role of el is "AXCheckBox" and (value of el as integer) is 1 then
                                set targetElem to el
                                exit repeat
                            end if
                        end try
                    end repeat
                else
                    repeat with el in allEls
                        try
                            set elId to (value of attribute "AXIdentifier" of el) as string
                            if elId contains theTarget then
                                set targetElem to el
                                exit repeat
                            end if
                        end try
                    end repeat
                end if
                
                if targetElem is not missing value then
                    set elemID to value of attribute "AXIdentifier" of targetElem
                    set isConnected to false
                    try
                        if role of targetElem is "AXDisclosureTriangle" and (value of targetElem as integer) is 1 then
                            set isConnected to true
                        else if role of targetElem is "AXCheckBox" and (value of targetElem as integer) is 1 then
                            set isConnected to true
                        end if
                    end try
                    
                    if theAction is "start" then
                        if isConnected then
                            try
                                key code 53
                            end try
                            return "Already mirroring to " & elemID
                        else
                            click targetElem
                            delay 0.25
                            try
                                key code 53
                            end try
                            return "Started mirroring to " & elemID
                        end if
                    else if theAction is "stop" then
                        click targetElem
                        delay 0.25
                        try
                            key code 53
                        end try
                        return "Stopped mirroring to " & elemID
                    end if
                else
                    try
                        key code 53
                    end try
                    if theAction is "stop" and theTarget is "" then
                        return "No active screen mirroring session found."
                    else
                        return "Error: Could not find display with identifier: " & theTarget
                    end if
                end if
            end tell
        end tell
    end run
    """
    code, out, err = run_applescript(script, action, target_id)
    if code != 0 or err:
        return f"Error: {err or out}"
    return out

# MARK: - CLI Commands

def cmd_list(timeout=1.0, as_json=False, verbose=False):
    devices = discover_devices(timeout=timeout, verbose=verbose)
    session = get_current_session_info(fast=True)
    active_dev_id = session["device_id"] if session else None
    online_displays = get_online_displays_fast() or []

    result = []
    for idx, d in enumerate(devices, 1):
        target = d["target_id"]
        is_active = False
        if active_dev_id and (active_dev_id in [d["deviceid"], d["psi"], target]):
            is_active = True
        elif any(d["name"].lower() in disp.get("name", "").lower() for disp in online_displays if "Built-in" not in disp.get("type", "")):
            is_active = True

        dev_data = {
            "index": idx,
            "name": d["name"],
            "target_id": target,
            "deviceid": d["deviceid"],
            "psi": d["psi"],
            "model": d["model"],
            "connected": is_active
        }
        result.append(dev_data)

    if as_json:
        print(json.dumps(result, indent=2), flush=True)
        return

    if not result:
        print("No AirPlay displays found on the network.")
        return

    print(f"\nFound {len(result)} AirPlay device(s):\n")
    for d in result:
        status_tag = " [CONNECTED]" if d["connected"] else ""
        print(f" {d['index']}  {d['name']}{status_tag}")
        print(f"    Target ID:   {d['target_id']}")
        if d["deviceid"] and d["deviceid"] != d["target_id"]:
            print(f"    MAC:         {d['deviceid']}")
        if d["psi"] and d["psi"] != d["target_id"]:
            print(f"    UUID (psi):  {d['psi']}")
        if d["model"]:
            print(f"    Model:       {d['model']}")
        print("")

def cmd_start(target_query, mode=None, timeout=None, force=False, as_json=False, verbose=False):
    if not target_query:
        die("start requires a target index, name, alias, or device ID (e.g. 1, 'LG', 'tv')",
            code=ExitCode.USAGE, as_json=as_json)

    # If force is specified and another display is active, disconnect it first
    session = get_current_session_info(fast=True)
    if session and force:
        cur_id = session.get("device_id", "")
        if verbose or not as_json:
            print(f"Active session detected ({cur_id}). Disconnecting due to --force...")
        toggle_mirroring_ui("stop", "")
        time.sleep(1.0)

    devices = load_cache()
    matched = resolve_target(target_query, devices, verbose=verbose)

    # If not resolved and timeout specified, retry scanning
    if not matched and timeout:
        deadline = time.time() + timeout
        while time.time() < deadline:
            devices = discover_devices(timeout=1.0, verbose=verbose)
            matched = resolve_target(target_query, devices, verbose=verbose)
            if matched:
                break
            time.sleep(0.5)

    if matched:
        target_name = matched["name"]
        target_id = matched["deviceid"] or matched["psi"] or matched["target_id"]
        if verbose or not as_json:
            print(f"Connecting to '{target_name}' (ID: {target_id})...")
        update_last_target(matched, mode=mode)
    else:
        target_name = target_query
        target_id = target_query
        if verbose or not as_json:
            print(f"Connecting to display ID '{target_id}'...")

    res = toggle_mirroring_ui("start", target_id)
    success = "Started" in res or "Already" in res

    if success and mode in ["mirror", "extend"]:
        apply_display_mode(mode, verbose=verbose)

    if as_json:
        print(json.dumps({
            "success": success,
            "target": target_name,
            "target_id": target_id,
            "mode": mode,
            "message": res
        }, indent=2), flush=True)
    else:
        print(res)

    if not success:
        sys.exit(ExitCode.FAILED)

def cmd_stop(target_query=None, as_json=False, verbose=False):
    target_id = ""
    target_name = None
    if target_query:
        devices = load_cache()
        matched = resolve_target(target_query, devices, verbose=verbose)
        if matched:
            target_id = matched["deviceid"] or matched["psi"] or matched["target_id"]
            target_name = matched["name"]
        else:
            target_id = target_query
            target_name = target_query

    res = toggle_mirroring_ui("stop", target_id)
    success = "Stopped" in res or "No active" in res

    if as_json:
        print(json.dumps({
            "success": success,
            "target": target_name or "active",
            "message": res
        }, indent=2), flush=True)
    else:
        print(res)

    if not success and "Error:" in res:
        sys.exit(ExitCode.FAILED)

def cmd_status(as_json=False, verbose=False):
    session = get_current_session_info(fast=True)
    state = load_state()
    last_target = state.get("last_target")

    online_displays = get_online_displays_fast() or []
    airplay_disp = next((d for d in online_displays if "External" in d.get("type", "") or "AirPlay" in d.get("name", "")), None)

    is_active = session is not None or airplay_disp is not None
    dev_id = session["device_id"] if session else (airplay_disp.get("name") if airplay_disp else None)
    mode = session["mode"] if session else (airplay_disp.get("mode") if airplay_disp else None)

    devices = load_cache()
    matched = resolve_target(dev_id, devices) if dev_id else None
    display_name = matched["name"] if matched else (airplay_disp.get("name") if airplay_disp else dev_id)

    if as_json:
        payload = {
            "active": is_active,
            "device": display_name,
            "id": dev_id,
            "mode": mode,
            "last_target": last_target
        }
        print(json.dumps(payload, indent=2), flush=True)
        return

    if is_active:
        print("Active Screen Mirroring Session:")
        print(f"  Device:  {display_name}")
        if dev_id:
            print(f"  ID:      {dev_id}")
        if mode:
            print(f"  Status:  {mode}")
    else:
        print("No active screen mirroring session.")

    if last_target:
        print(f"\nLast Connected Target: {last_target.get('name')} (ID: {last_target.get('target_id')})")
        if last_target.get("updated_at"):
            print(f"Last Used: {last_target.get('updated_at')}")

def cmd_toggle(target_query=None, timeout=8.0, mode=None, as_json=False, verbose=False):
    """
    Toggle AirPlay connection:
    - If active: cleanly disconnect.
    - If not active: reconnect to target (or last-used target) once it appears on network.
    """
    session = get_current_session_info(fast=True)
    online_displays = get_online_displays_fast() or []
    has_active_airplay = (session is not None) or any("AirPlay" in d.get("name", "") for d in online_displays)

    if has_active_airplay:
        if verbose or not as_json:
            print("Active AirPlay session detected. Disconnecting...")
        cur_dev_id = session.get("device_id") if session else None
        if cur_dev_id:
            devices = load_cache()
            matched = resolve_target(cur_dev_id, devices)
            if matched:
                update_last_target(matched, mode=session.get("mode"))
        time.sleep(0.3)
        cmd_stop(as_json=as_json, verbose=verbose)
        return

    # Inactive: determine target to connect to
    state = load_state()
    last_target = state.get("last_target")
    effective_target = target_query or (last_target.get("target_id") if last_target else None) or (last_target.get("name") if last_target else None)
    effective_mode = mode or state.get("last_mode")

    if not effective_target:
        msg = "No active session and no previous target saved. Specify a target: airplay-tool toggle <id|index|name>"
        die(msg, code=ExitCode.USAGE, as_json=as_json)

    if verbose or not as_json:
        print(f"No active session. Waiting up to {int(timeout)}s for target '{effective_target}' to appear...")

    start_time = time.time()
    found_dev = None

    while (time.time() - start_time) < timeout:
        devices = discover_devices(timeout=1.0, verbose=verbose)
        matched = resolve_target(effective_target, devices, verbose=verbose)
        if matched:
            found_dev = matched
            break
        time.sleep(0.5)

    if not found_dev:
        cached = load_cache()
        found_dev = resolve_target(effective_target, cached, verbose=verbose)

    if not found_dev:
        msg = f"Target '{effective_target}' did not appear on network within {int(timeout)} seconds."
        die(msg, code=ExitCode.UNCONFIRMED, as_json=as_json)

    target_name = found_dev["name"]
    target_id = found_dev["deviceid"] or found_dev["psi"] or found_dev["target_id"]

    if verbose or not as_json:
        print(f"Target '{target_name}' appeared. Connecting...")

    update_last_target(found_dev, mode=effective_mode)
    res = toggle_mirroring_ui("start", target_id)
    success = "Started" in res or "Already" in res

    if success and effective_mode in ["mirror", "extend"]:
        apply_display_mode(effective_mode, verbose=verbose)

    if as_json:
        print(json.dumps({
            "success": success,
            "action": "started",
            "target": target_name,
            "target_id": target_id,
            "mode": effective_mode,
            "message": res
        }, indent=2), flush=True)
    else:
        print(res)

    if not success:
        sys.exit(ExitCode.FAILED)

def is_target_connected(target_id, target_name):
    session = get_current_session_info(fast=False)
    if session:
        cur_id = session.get("device_id", "")
        if cur_id:
            if cur_id == target_id or normalize_identifier(cur_id) == normalize_identifier(target_id):
                return True
            if target_name and target_name.lower() in cur_id.lower():
                return True

    online_displays = get_online_displays_fast() or []
    for d in online_displays:
        if "Built-in" in d.get("type", ""):
            continue
        dname = d.get("name", "")
        if target_name and target_name.lower() in dname.lower():
            return True
        norm_t = normalize_identifier(target_id)
        if norm_t and norm_t in normalize_identifier(dname):
            return True
    return False

def cmd_watch(target_query=None, mode=None, interval_sec=60.0, as_json=False, verbose=False):
    """
    Watchdog keepalive daemon for AirPlay connections.
    If target_query is omitted, watches the active session or last connected target.
    Interval defaults to 60000ms (60s).
    In JSON mode (-j), streams JSON Lines events to stdout.
    """
    # Auto-resolve target if not provided
    if not target_query:
        session = get_current_session_info(fast=True)
        if session and session.get("device_id"):
            target_query = session["device_id"]
        else:
            state = load_state()
            last = state.get("last_target")
            if last:
                target_query = last.get("target_id") or last.get("name")

    if not target_query:
        die("watch requires a target display (e.g. 1, 'LG', 'tv') or an active/previous session",
            code=ExitCode.USAGE, as_json=as_json)

    devices = load_cache() or discover_devices(timeout=1.0, verbose=verbose)
    matched = resolve_target(target_query, devices, verbose=verbose)

    target_name = matched["name"] if matched else target_query
    target_id = (matched["deviceid"] or matched["psi"] or matched["target_id"]) if matched else target_query

    # Line-buffered output for real-time JSON streaming
    try:
        sys.stdout.reconfigure(line_buffering=True)
    except Exception:
        pass

    def handle_signal(sig, frame):
        if as_json:
            print(json.dumps({
                "event": "stopped",
                "target": target_name,
                "id": target_id,
                "at": iso_now()
            }), flush=True)
        else:
            sys.stderr.write("\nwatch: stopped\n")
        sys.exit(ExitCode.OK)

    for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(s, handle_signal)

    if as_json:
        print(json.dumps({
            "event": "start",
            "target": target_name,
            "id": target_id,
            "interval_ms": int(interval_sec * 1000),
            "interval_s": interval_sec,
            "at": iso_now()
        }), flush=True)
    else:
        print(f"🛡  AirPlay Watchdog active for '{target_name}' (ID: {target_id})")
        print(f"Poll interval: {format_interval(interval_sec)}. Press Ctrl-C to stop.\n")

    # Initial check & connection if not currently active
    if not is_target_connected(target_id, target_name):
        if as_json:
            print(json.dumps({
                "event": "initial_connect",
                "target": target_name,
                "id": target_id,
                "at": iso_now()
            }), flush=True)
        else:
            print(f"Target '{target_name}' not connected. Establishing initial connection...")
        cmd_start(target_query, mode=mode, as_json=False, verbose=verbose)

    reconnect_attempts = 0
    while True:
        # Sleep in small slices to remain immediately responsive to termination signals
        slept = 0.0
        while slept < interval_sec:
            slice_time = min(0.5, interval_sec - slept)
            time.sleep(slice_time)
            slept += slice_time

        active = is_target_connected(target_id, target_name)
        if active:
            reconnect_attempts = 0
            if verbose:
                if as_json:
                    print(json.dumps({
                        "event": "poll",
                        "connected": True,
                        "target": target_name,
                        "id": target_id,
                        "at": iso_now()
                    }), flush=True)
                else:
                    sys.stderr.write(f"[{time.strftime('%H:%M:%S')}] keepalive check: '{target_name}' is connected.\n")
        else:
            reconnect_attempts += 1
            ts = time.strftime("%Y-%m-%d %H:%M:%S")
            if as_json:
                print(json.dumps({
                    "event": "dropped",
                    "target": target_name,
                    "id": target_id,
                    "attempt": reconnect_attempts,
                    "at": iso_now()
                }), flush=True)
            else:
                print(f"[{ts}] ⚠️ Connection to '{target_name}' dropped! Reconnecting (attempt {reconnect_attempts})...")

            res = toggle_mirroring_ui("start", target_id)
            reconnected = "Started" in res or "Already" in res
            if reconnected and mode in ["mirror", "extend"]:
                apply_display_mode(mode, verbose=verbose)

            if as_json:
                print(json.dumps({
                    "event": "reconnect_result",
                    "target": target_name,
                    "id": target_id,
                    "success": reconnected,
                    "message": res,
                    "at": iso_now()
                }), flush=True)
            else:
                print(f"[{ts}] {res}")

            time.sleep(2.0)

def cmd_wait(target_query, state="connected", timeout=30.0, poll_sec=1.0, as_json=False, verbose=False):
    """
    Block until target reaches the expected state (connected, disconnected, online).
    Exits 0 on success, or 4 (UNCONFIRMED) on timeout.
    """
    if not target_query:
        die("wait requires a target display (e.g. 1, 'LG', 'tv')", code=ExitCode.USAGE, as_json=as_json)

    valid_states = ["connected", "disconnected", "online"]
    state = state.lower()
    if state not in valid_states:
        die(f"invalid wait state '{state}'. Expected one of: {', '.join(valid_states)}",
            code=ExitCode.USAGE, as_json=as_json)

    devices = load_cache() or discover_devices(timeout=1.0, verbose=verbose)
    matched = resolve_target(target_query, devices, verbose=verbose)
    target_name = matched["name"] if matched else target_query
    target_id = (matched["deviceid"] or matched["psi"] or matched["target_id"]) if matched else target_query

    start_time = time.time()
    deadline = start_time + timeout

    if verbose or not as_json:
        sys.stderr.write(f"Waiting up to {timeout}s for '{target_name}' to become {state}...\n")

    while time.time() < deadline:
        if state == "connected":
            if is_target_connected(target_id, target_name):
                elapsed = time.time() - start_time
                if as_json:
                    print(json.dumps({
                        "success": True,
                        "target": target_name,
                        "state": state,
                        "elapsed_s": round(elapsed, 2)
                    }, indent=2), flush=True)
                else:
                    print(f"Target '{target_name}' is connected ({round(elapsed, 2)}s)")
                sys.exit(ExitCode.OK)
        elif state == "disconnected":
            if not is_target_connected(target_id, target_name):
                elapsed = time.time() - start_time
                if as_json:
                    print(json.dumps({
                        "success": True,
                        "target": target_name,
                        "state": state,
                        "elapsed_s": round(elapsed, 2)
                    }, indent=2), flush=True)
                else:
                    print(f"Target '{target_name}' is disconnected ({round(elapsed, 2)}s)")
                sys.exit(ExitCode.OK)
        elif state == "online":
            found = discover_devices(timeout=min(1.0, deadline - time.time()), verbose=verbose)
            m = resolve_target(target_query, found, verbose=verbose)
            if m:
                elapsed = time.time() - start_time
                if as_json:
                    print(json.dumps({
                        "success": True,
                        "target": m["name"],
                        "target_id": m["target_id"],
                        "state": state,
                        "elapsed_s": round(elapsed, 2)
                    }, indent=2), flush=True)
                else:
                    print(f"Target '{m['name']}' is online ({round(elapsed, 2)}s)")
                sys.exit(ExitCode.OK)

        time.sleep(poll_sec)

    elapsed = time.time() - start_time
    msg = f"timed out after {round(elapsed, 1)}s waiting for '{target_name}' to become {state}"
    if as_json:
        print(json.dumps({
            "error": msg,
            "code": ExitCode.UNCONFIRMED,
            "success": False,
            "target": target_name,
            "state": state,
            "elapsed_s": round(elapsed, 2)
        }, indent=2), flush=True)
    else:
        sys.stderr.write(f"error: {msg}\n")
    sys.exit(ExitCode.UNCONFIRMED)

def cmd_logs(last_time="2h", filter_query=None, limit=200, follow=False, as_json=False):
    predicate = (
        '(process == "AirPlayXPCHelper" OR process == "ControlCenter") AND '
        '(eventMessage CONTAINS[c] "stream" OR eventMessage CONTAINS[c] "disconnect" OR '
        'eventMessage CONTAINS[c] "teardown" OR eventMessage CONTAINS[c] "bottomup" OR '
        'eventMessage CONTAINS[c] "error" OR eventMessage CONTAINS[c] "RTC metrics of sessionType Screen")'
    )

    if follow:
        # Live streaming via log stream
        cmd = ["log", "stream", "--predicate", predicate, "--style", "syslog"]
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)

        def handle_log_sig(sig, frame):
            p.kill()
            sys.exit(ExitCode.OK)

        signal.signal(signal.SIGINT, handle_log_sig)
        signal.signal(signal.SIGTERM, handle_log_sig)

        try:
            for line in p.stdout:
                line_str = line.strip()
                if not line_str or line_str.startswith("Filtering"):
                    continue
                if filter_query and filter_query.lower() not in line_str.lower():
                    continue

                if as_json:
                    print(json.dumps({
                        "raw": line_str,
                        "at": iso_now()
                    }), flush=True)
                else:
                    print(line_str, flush=True)
        except Exception:
            p.kill()
        sys.exit(ExitCode.OK)

    # Historical show
    cmd = [
        "log", "show",
        "--predicate", predicate,
        "--style", "syslog",
        "--last", last_time
    ]
    p = subprocess.run(cmd, capture_output=True, text=True)
    lines = [l for l in p.stdout.splitlines() if l.strip() and not l.startswith("Filtering")]

    if filter_query:
        lines = [l for l in lines if filter_query.lower() in l.lower()]

    if limit > 0 and len(lines) > limit:
        lines = lines[-limit:]

    if as_json:
        events = [{"raw": l} for l in lines]
        print(json.dumps(events, indent=2), flush=True)
        return

    print(f"macOS Unified Log AirPlay events (last {last_time}):\n")
    if not lines:
        print("No recent AirPlay session drop or disconnect events found.")
        return

    for l in lines:
        print(l)

def cmd_alias(subargs, force=False, as_json=False):
    aliases = load_aliases()
    if not subargs or subargs[0] in ["list", "show", "-l"]:
        if as_json:
            print(json.dumps(aliases, indent=2), flush=True)
        else:
            if not aliases:
                print("No aliases configured. Add one with: airplay-tool alias set <name> <target>")
            else:
                print("Configured AirPlay Aliases:")
                for k, v in sorted(aliases.items()):
                    print(f"  {k} -> {v}")
        return

    action = subargs[0].lower()
    if action == "set":
        if len(subargs) < 3:
            die("Usage: airplay-tool alias set <alias-name> <target-id-or-name>",
                code=ExitCode.USAGE, as_json=as_json)
        name = subargs[1].lower()
        val = subargs[2]

        # Prevent reserved words or hardware IDs from becoming aliases
        reserved = ["list", "start", "stop", "connect", "disconnect", "toggle", "status", "watch", "keepalive", "wait", "logs", "diagnose", "alias", "aliases", "help", "version"]
        if name in reserved:
            die(f"cannot use reserved command name '{name}' as an alias", code=ExitCode.USAGE, as_json=as_json)

        norm_id = normalize_identifier(name)
        if norm_id and len(norm_id) in (12, 32):
            die(f"alias '{name}' looks like a MAC address or UUID; use a friendly name", code=ExitCode.USAGE, as_json=as_json)

        if not re.match(r"^[a-zA-Z0-9_\-]+$", name):
            die(f"invalid alias name '{name}': only alphanumeric characters, dashes, and underscores allowed",
                code=ExitCode.USAGE, as_json=as_json)

        aliases[name] = val
        save_aliases(aliases)
        if as_json:
            print(json.dumps({"success": True, "alias": name, "target": val}), flush=True)
        else:
            print(f"✅ Alias '{name}' set to '{val}'")
    elif action in ["remove", "rm", "delete"]:
        if len(subargs) < 2:
            die("Usage: airplay-tool alias remove <alias-name>", code=ExitCode.USAGE, as_json=as_json)
        name = subargs[1].lower()
        if name in aliases:
            del aliases[name]
            save_aliases(aliases)
            if as_json:
                print(json.dumps({"success": True, "removed": name}), flush=True)
            else:
                print(f"✅ Alias '{name}' removed")
        else:
            die(f"Alias '{name}' not found", code=ExitCode.FAILED, as_json=as_json)
    else:
        die(f"Unknown alias action '{action}'. Use set, remove, or list.",
            code=ExitCode.USAGE, as_json=as_json)


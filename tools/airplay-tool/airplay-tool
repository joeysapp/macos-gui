def main():
    raw_args = sys.argv[1:]
    if not raw_args:
        print_global_usage()
        sys.exit(0)

    # First check top-level help / version
    if raw_args[0] in ["-h", "--help"]:
        print_global_usage()
        sys.exit(0)

    if raw_args[0] in ["-V", "--version", "version"]:
        print(f"{TOOL_NAME} {VERSION}")
        sys.exit(0)

    # Parse options and positional words
    as_json = False
    verbose = False
    quiet = False
    force = False
    follow = False
    mode = None
    timeout = None
    interval_val = None
    last_time = "2h"
    limit_val = 200
    grep_pattern = None

    pos_args = []
    i = 0
    while i < len(raw_args):
        arg = raw_args[i]
        if arg in ["-j", "--json", "json"]:
            as_json = True
        elif arg in ["-v", "--verbose"]:
            verbose = True
        elif arg in ["-q", "--quiet"]:
            quiet = True
        elif arg == "--force":
            force = True
        elif arg in ["-f", "--follow"]:
            follow = True
        elif arg in ["-m", "--mode"]:
            i += 1
            if i < len(raw_args):
                mode = raw_args[i].lower()
            else:
                die("--mode requires an argument (mirror or extend)", code=ExitCode.USAGE, as_json=as_json)
        elif arg.startswith("--mode="):
            mode = arg.split("=", 1)[1].lower()
        elif arg in ["-t", "--timeout"]:
            i += 1
            if i < len(raw_args):
                try:
                    timeout = float(raw_args[i])
                except ValueError:
                    die(f"invalid timeout '{raw_args[i]}': expected number of seconds", code=ExitCode.USAGE, as_json=as_json)
            else:
                die("--timeout requires seconds", code=ExitCode.USAGE, as_json=as_json)
        elif arg.startswith("--timeout="):
            try:
                timeout = float(arg.split("=", 1)[1])
            except ValueError:
                die(f"invalid timeout: expected number of seconds", code=ExitCode.USAGE, as_json=as_json)
        elif arg in ["-i", "--interval"]:
            i += 1
            if i < len(raw_args):
                interval_val = raw_args[i]
            else:
                die("--interval requires a duration argument (e.g. 60000ms, 60s, 1m)", code=ExitCode.USAGE, as_json=as_json)
        elif arg.startswith("--interval="):
            interval_val = arg.split("=", 1)[1]
        elif arg == "--last":
            i += 1
            if i < len(raw_args):
                last_time = raw_args[i]
            else:
                die("--last requires a duration window (e.g. 30m, 2h)", code=ExitCode.USAGE, as_json=as_json)
        elif arg.startswith("--last="):
            last_time = arg.split("=", 1)[1]
        elif arg in ["--limit"]:
            i += 1
            if i < len(raw_args):
                try:
                    limit_val = int(raw_args[i])
                except ValueError:
                    die(f"invalid limit '{raw_args[i]}': expected integer", code=ExitCode.USAGE, as_json=as_json)
            else:
                die("--limit requires an integer count", code=ExitCode.USAGE, as_json=as_json)
        elif arg.startswith("--limit="):
            try:
                limit_val = int(arg.split("=", 1)[1])
            except ValueError:
                die("invalid limit: expected integer count", code=ExitCode.USAGE, as_json=as_json)
        elif arg in ["--grep", "--filter"]:
            i += 1
            if i < len(raw_args):
                grep_pattern = raw_args[i]
            else:
                die(f"{arg} requires a search pattern", code=ExitCode.USAGE, as_json=as_json)
        elif arg.startswith("--grep="):
            grep_pattern = arg.split("=", 1)[1]
        elif arg.startswith("--filter="):
            grep_pattern = arg.split("=", 1)[1]
        elif arg in ["-h", "--help"]:
            pos_args.append("help")
        else:
            pos_args.append(arg)
        i += 1

    if not pos_args:
        print_global_usage()
        sys.exit(ExitCode.OK)

    command = pos_args[0].lower()
    subargs = pos_args[1:]

    # Handle help command or trailing help request
    if command == "help" or (subargs and subargs[0] in ["-h", "--help", "help"]):
        target_help = subargs[0] if command == "help" and subargs else command
        if target_help in HELP_TEXTS:
            print(HELP_TEXTS[target_help])
            sys.exit(ExitCode.OK)
        else:
            print_global_usage()
            sys.exit(ExitCode.OK)

    # Command dispatch
    if command == "list":
        t = timeout if timeout is not None else 1.0
        cmd_list(timeout=t, as_json=as_json, verbose=verbose)

    elif command in ["start", "connect"]:
        if not subargs:
            die(f"{command} requires a target index, name, alias, or device ID (e.g. 1, 'LG', 'tv')",
                code=ExitCode.USAGE, as_json=as_json)
        cmd_start(subargs[0], mode=mode, timeout=timeout, force=force, as_json=as_json, verbose=verbose)

    elif command in ["stop", "disconnect"]:
        target = subargs[0] if subargs else None
        cmd_stop(target, as_json=as_json, verbose=verbose)

    elif command == "status":
        cmd_status(as_json=as_json, verbose=verbose)

    elif command == "toggle":
        target = subargs[0] if subargs else None
        t = timeout if timeout is not None else 8.0
        cmd_toggle(target_query=target, timeout=t, mode=mode, as_json=as_json, verbose=verbose)

    elif command in ["watch", "keepalive"]:
        target = subargs[0] if subargs else None
        try:
            interval_sec = parse_duration(interval_val, default_sec=60.0)
        except ValueError as e:
            die(f"invalid interval: {e}", code=ExitCode.USAGE, as_json=as_json)
        cmd_watch(target, mode=mode, interval_sec=interval_sec, as_json=as_json, verbose=verbose)

    elif command == "wait":
        if not subargs:
            die("wait requires a target display (e.g. 1, 'LG', 'tv')", code=ExitCode.USAGE, as_json=as_json)
        target = subargs[0]
        state = subargs[1] if len(subargs) > 1 else "connected"
        t = timeout if timeout is not None else 30.0
        try:
            poll_sec = parse_duration(interval_val, default_sec=1.0)
        except ValueError as e:
            die(f"invalid interval: {e}", code=ExitCode.USAGE, as_json=as_json)
        cmd_wait(target, state=state, timeout=t, poll_sec=poll_sec, as_json=as_json, verbose=verbose)

    elif command in ["logs", "diagnose"]:
        cmd_logs(last_time=last_time, filter_query=grep_pattern, limit=limit_val,
                 follow=follow, as_json=as_json)

    elif command in ["alias", "aliases"]:
        cmd_alias(subargs, force=force, as_json=as_json)

    elif command == "version":
        print(f"{TOOL_NAME} {VERSION}")
        sys.exit(ExitCode.OK)

    else:
        die(f"unknown command '{command}'. Run '{TOOL_NAME} --help' for usage.",
            code=ExitCode.USAGE, as_json=as_json)

if __name__ == "__main__":
    main()

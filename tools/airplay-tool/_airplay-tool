#compdef airplay-tool airplay airplay_connect

_airplay-tool() {
    local -a commands
    commands=(
        'list:Scan and list available AirPlay displays with indices and status'
        'start:Connect to an AirPlay display (by index, friendly name, alias, or ID)'
        'stop:Disconnect active AirPlay session (or specify device)'
        'toggle:Smart toggle: disconnect if active, or reconnect to last host'
        'status:Show current active AirPlay session and last connected host'
        'watch:Auto-reconnect watchdog daemon for intermittent AirPlay connections'
        'logs:View recent macOS Unified Log AirPlay teardown/disconnect events'
        'alias:Manage friendly device aliases (list, set, remove)'
    )

    local -a global_opts
    global_opts=(
        '(-j --json)'{-j,--json}'[Output machine-readable JSON format]'
        '(-v --verbose)'{-v,--verbose}'[Enable verbose diagnostic output]'
        '(-h --help)'{-h,--help}'[Show usage instructions]'
        '(-V --version)'{-V,--version}'[Show tool version]'
    )

    _arguments -C \
        $global_opts \
        '1: :->command' \
        '*:: :->args'

    case $state in
        command)
            _describe -t commands 'airplay-tool command' commands
            ;;
        args)
            local cmd="$words[1]"
            case $cmd in
                start|toggle|watch)
                    _arguments -C \
                        $global_opts \
                        '(-m --mode)'{-m,--mode}'[Configure display mode upon connect]:mode:(mirror extend)' \
                        '(-t --timeout)'{-t,--timeout}'[Network discovery wait timeout in seconds]:timeout:' \
                        '1:target:->targets'
                    if [[ $state == targets ]]; then
                        local -a targets
                        targets=(
                            '1:Target index 1'
                            '2:Target index 2'
                            'tv:Configured TV alias'
                            'office:Configured office alias'
                            'LG:LG webOS TV'
                            'torus:Nearby Mac host'
                        )
                        _describe -t targets 'AirPlay display target' targets
                    fi
                    ;;
                stop)
                    _arguments -C \
                        $global_opts \
                        '1:target:->targets'
                    if [[ $state == targets ]]; then
                        local -a targets
                        targets=(
                            '1:Target index 1'
                            '2:Target index 2'
                            'LG:LG webOS TV'
                            'torus:Nearby Mac host'
                        )
                        _describe -t targets 'AirPlay display target' targets
                    fi
                    ;;
                logs)
                    _arguments -C \
                        $global_opts \
                        '--last[Unified log time window]:duration:(15m 30m 1h 2h 6h 12h 24h)' \
                        '(-f --filter)'{-f,--filter}'[Filter event messages by substring]:filter:'
                    ;;
                alias)
                    local -a alias_cmds
                    alias_cmds=(
                        'list:List configured aliases'
                        'set:Set a friendly alias (alias set <name> <target>)'
                        'remove:Remove an alias (alias remove <name>)'
                    )
                    _describe -t alias_cmds 'alias action' alias_cmds
                    ;;
            esac
            ;;
    esac
}

_airplay-tool "$@"

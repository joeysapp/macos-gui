#compdef airplay-tool airplay airplay_connect

# Zsh completion for airplay-tool (aliases: airplay, airplay_connect).
# Device targets are read live from airplay-tool list -j or cache; aliases from ~/.config/macos-gui/airplay_aliases.json.

_airplay-tool_aliases() {
    local config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/macos-gui"
    local file="$config_dir/airplay_aliases.json"
    local line
    local -a names
    [[ -r "$file" ]] || return 1
    while IFS= read -r line; do
        [[ $line =~ '"([^"]+)"[[:space:]]*:[[:space:]]*"([^"]*)"' ]] && names+=("${match[1]}:-> ${match[2]}")
    done < "$file"
    _describe -t aliases 'alias' names
}

_airplay-tool_targets() {
    local tool=${commands[airplay-tool]:-${commands[airplay]}}
    local -a devices objs
    local json o idx name target_id model sep='},{'
    local cache_file="${XDG_CACHE_HOME:-$HOME/.cache}/macos-gui/airplay_cache.json"

    if [[ -r "$cache_file" ]]; then
        json=$(<"$cache_file")
        objs=(${(ps:$sep:)json})
        for o in $objs; do
            [[ $o =~ '"name":"(([^"\\]|\\.)*)"' ]] && name=${match[1]}
            [[ $o =~ '"target_id":"([0-9A-Fa-f:-]+)"' ]] && target_id=${match[1]}
            [[ $o =~ '"model":"([^"]*)"' ]] && model=${match[1]}
            if [[ -n "$name" ]]; then
                devices+=("${name//:/\\:}:${target_id} ${model}")
            fi
        done
    fi

    _airplay-tool_aliases
    if (( $#devices )); then
        _describe -t devices 'discovered device' devices
    else
        _message 'target: index, alias, name substring, MAC, or UUID'
    fi
}

_airplay-tool() {
    local curcontext="$curcontext" state line ret=1
    typeset -A opt_args

    local -a subcmds
    subcmds=(
        'list:Scan and list available AirPlay displays with indices and status'
        'start:Connect to an AirPlay display (by index, friendly name, alias, or ID)'
        'connect:Alias for start'
        'stop:Disconnect active AirPlay session (or specify device)'
        'disconnect:Alias for stop'
        'toggle:Smart toggle: disconnect if active, or reconnect to last host'
        'status:Show current active AirPlay session and last connected host'
        'watch:Auto-reconnect watchdog daemon (default: 60000ms)'
        'keepalive:Alias for watch'
        'wait:Block until target is connected, disconnected, or online'
        'logs:View recent macOS Unified Log AirPlay teardown/disconnect events'
        'diagnose:Alias for logs'
        'alias:Manage friendly device aliases (list, set, remove)'
        'help:Show help for a command'
        'version:Show tool version'
    )

    local -a global_opts
    global_opts=(
        '(-j --json)'{-j,--json}'[Output machine-readable JSON format]'
        '(-v --verbose)'{-v,--verbose}'[Enable detailed diagnostic output]'
        '(-q --quiet)'{-q,--quiet}'[Suppress non-essential output]'
        '(-h --help)'{-h,--help}'[Show usage instructions]'
        '(-V --version)'{-V,--version}'[Show tool version]'
    )

    _arguments -C \
        $global_opts \
        '1: :->command' \
        '*:: :->args' && ret=0

    case $state in
        command)
            _describe -t subcmds 'airplay-tool command' subcmds && ret=0
            ;;
        args)
            local cmd="$words[1]"
            case $cmd in
                start|connect)
                    _arguments -C \
                        $global_opts \
                        '(-m --mode)'{-m,--mode}'[Configure display mode upon connect]:mode:(mirror extend)' \
                        '(-t --timeout)'{-t,--timeout}'[Network discovery wait timeout in seconds]:timeout (seconds):' \
                        '--force[Disconnect existing AirPlay session before connecting]' \
                        '1:target:->targets' && ret=0
                    if [[ $state == targets ]]; then
                        _airplay-tool_targets && ret=0
                    fi
                    ;;
                stop|disconnect)
                    _arguments -C \
                        $global_opts \
                        '1:target:->targets' && ret=0
                    if [[ $state == targets ]]; then
                        _airplay-tool_targets && ret=0
                    fi
                    ;;
                toggle)
                    _arguments -C \
                        $global_opts \
                        '(-m --mode)'{-m,--mode}'[Configure display mode upon connect]:mode:(mirror extend)' \
                        '(-t --timeout)'{-t,--timeout}'[Network discovery wait timeout in seconds]:timeout (seconds):' \
                        '1:target:->targets' && ret=0
                    if [[ $state == targets ]]; then
                        _airplay-tool_targets && ret=0
                    fi
                    ;;
                watch|keepalive)
                    _arguments -C \
                        $global_opts \
                        '(-i --interval)'{-i,--interval}'[Polling check interval]:interval (e.g. 60000ms, 60s, 1m):' \
                        '(-m --mode)'{-m,--mode}'[Display arrangement mode upon reconnect]:mode:(mirror extend)' \
                        '1:target:->targets' && ret=0
                    if [[ $state == targets ]]; then
                        _airplay-tool_targets && ret=0
                    fi
                    ;;
                wait)
                    _arguments -C \
                        $global_opts \
                        '(-t --timeout)'{-t,--timeout}'[Wait timeout in seconds]:timeout (seconds):' \
                        '(-i --interval)'{-i,--interval}'[Polling interval]:interval (e.g. 1s, 500ms):' \
                        '1:target:->targets' \
                        '2:state:(connected disconnected online)' && ret=0
                    if [[ $state == targets ]]; then
                        _airplay-tool_targets && ret=0
                    fi
                    ;;
                list)
                    _arguments -C \
                        $global_opts \
                        '(-t --timeout)'{-t,--timeout}'[Discovery timeout in seconds]:timeout (seconds):' && ret=0
                    ;;
                status)
                    _arguments -C \
                        $global_opts && ret=0
                    ;;
                logs|diagnose)
                    _arguments -C \
                        $global_opts \
                        '--last[Unified log time window]:duration:(15m 30m 1h 2h 6h 12h 24h)' \
                        '--limit[Maximum log lines to return]:limit (lines):' \
                        '(--filter --grep)'{--filter,--grep}'[Filter event messages by substring]:pattern:' \
                        '(-f --follow)'{-f,--follow}'[Stream live Unified Log events in real time]' && ret=0
                    ;;
                alias|aliases)
                    local -a alias_cmds
                    alias_cmds=(
                        'list:List configured aliases'
                        'set:Set a friendly alias (alias set <name> <target>)'
                        'remove:Remove an alias (alias remove <name>)'
                    )
                    if (( CURRENT == 2 )); then
                        _describe -t alias_cmds 'alias action' alias_cmds && ret=0
                    elif (( CURRENT == 3 )) && [[ $words[2] == (remove|rm|delete) ]]; then
                        _airplay-tool_aliases && ret=0
                    fi
                    ;;
                help)
                    _describe -t subcmds 'command to describe' subcmds && ret=0
                    ;;
            esac
            ;;
    esac
    return ret
}

_airplay-tool "$@"

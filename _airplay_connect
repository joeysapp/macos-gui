#compdef airplay-connect

_airplay-connect() {
    local -a commands
    commands=(
        'start:begin bluetooth connection with idx or id'
								'stop:end bluetooth connection via idx or id
								'list:scan local network for available hosts': 
        'status:sohow current bluetooth information - BROKEN ON macOSd'
    )

    _arguments -s \
        '1:operation:->operation' \
        '2:host:_ssh_hosts' \
        '(-v --verbose)'{-v,--verbose}'[show transfer status]' \
        '(-h --ehlp)'{-h, --help}'[show usage]' \
        '--ssh[pass an option to ssh]:ssh option' \
        '*::arguments:->arguments'

    case "$state" in
        operation)
            _describe 'operation' commands
            ;;

        arguments)
            _ssh_hosts
            ;;
    esac
}

_airplay-connect "$@"